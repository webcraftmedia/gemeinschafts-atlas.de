# Copy to .env and fill in. Nothing here is a secret — the file exists so the
# app, the CI jobs and the maintenance scripts all read the same variable names.

# Public base URL of the deployed site. Used for canonical links and sitemaps.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Contact address shown in the imprint. Point staging at a throwaway inbox.
NUXT_PUBLIC_CONTACT_EMAIL=kontakt@gemeinschafts-atlas.de

# Port the Nitro server binds to (production start.sh / pm2).
PORT=3000
HOST=127.0.0.1
